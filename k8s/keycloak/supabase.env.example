# Copy to supabase.env and fill in values:
#   cp supabase.env.example supabase.env
#
# Deploy:
#   ./deploy.sh

# --- Supabase Postgres (Keycloak persistence, Direct connection) ---
# Dashboard → Project Settings → Database → Connection string → URI (Direct)

# Option A: full JDBC URL (host만 넣으면 Keycloak이 기동하지 않음 — :5432/postgres?sslmode=require 필수)
# Pooler (Session, port 5432):
#   KC_DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#   KC_DB_USERNAME=postgres.YOUR_PROJECT_REF
# Direct (권장, Keycloak 마이그레이션):
#   KC_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#   KC_DB_USERNAME=postgres
KC_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Option B: omit KC_DB_URL and set host/port/name instead (deploy.sh builds JDBC URL)
# SUPABASE_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres

KC_DB_USERNAME=postgres
KC_DB_PASSWORD=

# --- Keycloak bootstrap admin (Admin Console) ---
# 최초 DB 초기화 시에만 자동 적용됨. 이후 비밀번호 변경 시:
#   ./sync-admin-password.sh
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Public hostname (Ingress + KC_HOSTNAME) ---
KEYCLOAK_HOSTNAME=auth.example.com
