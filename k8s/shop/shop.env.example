# Copy to shop.env and adjust for your cluster / DNS.
SHOP_HOSTNAME=shop.bettercodelab.com
ADMIN_HOSTNAME=admin.bettercodelab.com
SHOP_IMAGE=shop-next:latest

# Auth.js + Keycloak (./setup-keycloak-client.sh or Keycloak Admin UI)
AUTH_SECRET=
AUTH_URL=https://shop.bettercodelab.com
AUTH_KEYCLOAK_ID=shop-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=https://auth.bettercodelab.com/realms/shop

# Comma-separated Keycloak login emails allowed on the admin hostname
# ADMIN_EMAILS=you@example.com

# Supabase (Next.js server — optional if DATABASE_URL is set in the same secret)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgresql://...

# Stripe Checkout (optional — cart "Pay with card")
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
