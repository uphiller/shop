# Copy to admin.env (or rely on ../shop/shop.env + ADMIN_IMAGE below)
ADMIN_HOSTNAME=admin.bettercodelab.com
ADMIN_IMAGE=shop-admin:latest
SHOP_HOSTNAME=shop.bettercodelab.com

# Auth.js — AUTH_URL must match the admin public URL
ADMIN_AUTH_URL=https://admin.bettercodelab.com
AUTH_SECRET=
AUTH_KEYCLOAK_ID=shop-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=https://auth.bettercodelab.com/realms/shop

# Comma-separated Keycloak login emails allowed in admin
# ADMIN_EMAILS=you@example.com

# Supabase (상품 관리 — 비어 있으면 ../shop/shop.env 값을 deploy.sh 가 병합)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
