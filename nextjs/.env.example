AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_KEYCLOAK_ID=shop-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=https://auth.bettercodelab.com/realms/shop

# Supabase (shop catalog). Prefer REST keys on the server; DATABASE_URL is optional fallback.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Optional: direct Postgres (pooler). scripts/sync-nextjs-supabase-env.sh can generate from k8s/keycloak/supabase.env
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Stripe Checkout (KRW). Webhook: POST /api/webhooks/stripe (checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # optional if you add Stripe Elements later
